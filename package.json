{
  "name": "react-credly-badges",
  "version": "0.1.0",
  "description": "A lightweight React component for displaying public Credly badges through a Cloudflare Worker.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/client/index.cjs",
  "module": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "prepare": "husky",
    "prepack": "npm run typecheck && npm run lint && npm run build"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/react": "^19.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "react": "^19.0.0",
    "semantic-release": "^25.0.9",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "keywords": ["react", "credly", "badges", "typescript"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/Safnaj/react-credly-badges#readme",
  "bugs": {
    "url": "https://github.com/Safnaj/react-credly-badges/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Safnaj/react-credly-badges.git"
  }
}
